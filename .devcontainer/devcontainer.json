{
  "name": "@repo/app",
  "dockerComposeFile": ["./compose.yml"],
  "service": "workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "workspaceFolder": "/workspace",
  "mounts": [
    // Persist the user profile across rebuilds.
    {
      "source": "profile-${devcontainerId}",
      "target": "/home/node",
      "type": "volume"
    },
    {
      // An anonymous volume that gets destroyed on rebuild,
      // which allows VS Code to reinstall extensions and dotfiles.
      "target": "/home/node/.vscode-server",
      "type": "volume"
    }
  ],
  "postCreateCommand": "pnpm i",
  "postStartCommand": "pnpm workspace:init",
  "forwardPorts": ["emulator:4004", "workspace:4005"],
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "always"
        },
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "files.exclude": {
          "**/node_modules": true,
          "**/.pnpm-store": true,
          "**/.cache": true,
          "**/dist": true
        },
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/node_modules/**": true,
          "**/.pnpm-store/**": true,
          "**/dist/**": true
        },
        "npm.packageManager": "pnpm",
        "oxc.fixKind": "safe_fix",
        "oxc.path.node": "/usr/local/bin/node"
      }
    }
  }
}
